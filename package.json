{
  "name": "shredit",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "node --require ./scripts/inject-peer-address.cjs ./node_modules/next/dist/bin/next dev -p 3232",
    "build": "node --require ./scripts/windows-symlink-fallback.cjs ./node_modules/next/dist/bin/next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local --require ./scripts/inject-peer-address.cjs ./.next/standalone/server.js",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "cleanup:expired": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup-expired.ts",
    "db:reconcile-capacity": "node --env-file-if-exists=.env.local --import tsx scripts/reconcile-capacity.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.468.0",
    "next": "^15.4.1",
    "next-intl": "^4.1.0",
    "pg": "^8.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
