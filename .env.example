# Shredit local development template. Copy to .env.local and replace local-only
# placeholders. Never use a production DATABASE_URL or production secrets here.

NODE_ENV=development
SHREDIT_LOCAL_EPHEMERAL=false
PORT=3232
HOSTNAME=127.0.0.1

# Local services from docker-compose.local.yml
DATABASE_URL=postgresql://shredit:shredit@127.0.0.1:5432/shredit
VALKEY_URL=redis://127.0.0.1:6379

# Canonical public origins. Production must use HTTPS on shredit.dev.
PUBLIC_BASE_URL=https://shredit.dev
ONION_URL=
GIT_REPOSITORY_URL=https://github.com/AlphaW84/shredit_dev
# Temporarily false while the public repository is moving to its final account.
PUBLIC_REPOSITORY_LINKS_ENABLED=false
NEXT_PUBLIC_GIT_COMMIT=local-dev
SECURITY_CONTACT=mailto:security@example.invalid
ABUSE_CONTACT=mailto:abuse@example.invalid
SECURITY_POLICY_URL=https://shredit.dev/security
ABUSE_POLICY_URL=https://shredit.dev/abuse

# Turnstile is disabled for local development unless explicitly testing it.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=shredit-create
TURNSTILE_BYPASS_COUNTRIES=CN
TURNSTILE_BYPASS_ONION=true
GEOIP_DB_PATH=
# Production requires one random 32-byte base64url token shared only with the
# application and the trusted ingress. Generate it with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Leave it empty only for direct local development and legacy peer-CIDR tests.
INGRESS_AUTH_TOKEN=
# Production Traefik must overwrite X-Shredit-Ingress-Auth and
# X-Shredit-Surface after selecting the public vhost. These CIDRs identify
# trusted upstream forwarding hops (for example Cloudflare's published IPv4
# and IPv6 ranges), not a resolved Cloudflare edge address or ephemeral
# application-network container address.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Generate unique local values. These are examples, not production secrets.
IP_HASH_SECRET=local-only-replace-with-random-32-byte-secret
IP_HASH_SECRET_PREVIOUS=
POW_SECRET=local-only-replace-with-random-32-byte-secret
IDEMPOTENCY_HMAC_SECRET=local-only-replace-with-random-32-byte-secret

# Anti-abuse and retention defaults from the specification.
POW_DIFFICULTY_BITS=18
IDEMPOTENCY_TOMBSTONE_RETENTION_DAYS=30
CREATE_LIMIT_PER_IP_HOUR=10
CREATE_LIMIT_PER_IP_DAY=50
PASSWORD_FAILURE_LIMIT_PER_NOTE_15M=5
PASSWORD_FAILURE_LIMIT_PER_IP_HOUR=50
ONION_TOKENS_PER_HOUR=200
ONION_TOKENS_PER_DAY=1000
ONION_TOKEN_BURST=20
ONION_TOKEN_BYTES=8192

# Use finite, deliberately small local capacity values. Production values are
# operator-owned Dokploy configuration and must never be inferred from these.
MAX_ACTIVE_NOTE_BYTES=104857600
MAX_ACTIVE_NOTE_COUNT=10000

# Argon2id defaults. All remain server-only; do not prefix with NEXT_PUBLIC_.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
ARGON2_MAX_CONCURRENCY=4
ARGON2_VERIFY_TIMEOUT_MS=5000
